// The CORTAO main pass on shtetl's G-buffer, occlusion only (the version line,
// the defines and the CORTAO sources are put in front of this by
// AmbientOcclusion.cpp). Writes the visibility (1 = open), as ao_ssao.frag does.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform usampler2D samplerPacked;
layout(binding = 1) uniform sampler2D samplerNormal;
layout(binding = 2) uniform usampler3D samplerOccluders;
layout(binding = 3) uniform MainPassBlock
{
    CORTAOMainPassParameters p;
} ubo;
layout(binding = 4, r32f) uniform writeonly image2D outOcclusion;

cortao_half3 cortao_loadNormal(cortao_int2 pixelCoords)
{
    vec3 n = normalize(texelFetch(samplerNormal, pixelCoords, 0).rgb * 2.0 - 1.0);
    n.z = max(n.z, -0.7); // as in the prepass
    return normalize(n);
}

cortao_uint cortao_samplePackedData(cortao_float2 texCoords, cortao_float mipmap)
{
    return textureLod(samplerPacked, texCoords, mipmap).r;
}

cortao_uint cortao_sampleOccluderLookupTable(cortao_float3 texCoords)
{
    return textureLod(samplerOccluders, texCoords, 0.0).r;
}

void cortao_writeResult(cortao_int2 pixelCoords, cortao_half occlusion, cortao_half3 bentNormal, cortao_half3x3 tangentSpaceTransform, cortao_uint rayBits)
{
    imageStore(outOcclusion, pixelCoords, vec4(occlusion, 0.0, 0.0, 0.0));
}

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const uvec2 resolution = cortao_getResolution(ubo.p.packedResolution);
    if (pixel.x >= resolution.x || pixel.y >= resolution.y) return;

    // The sky is not written by the main pass; the blur reads it, as open.
    if (texelFetch(samplerPacked, ivec2(pixel), 0).r == 0u)
    {
        imageStore(outOcclusion, ivec2(pixel), vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }
    cortao_mainPass(pixel, ubo.p);
}
